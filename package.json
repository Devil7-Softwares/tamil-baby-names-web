{
  "name": "tamil-baby-names",
  "version": "1.0.0",
  "description": "Monorepo for the Tamil baby names web app and its services.",
  "repository": "https://github.com/Devil7-Softwares/tamil-baby-names-web",
  "author": "Dineshkumar T (Devil7DK)",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "husky",
    "dev": "turbo dev",
    "build": "turbo build",
    "preview": "yarn workspace @tbn/web preview",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12"
  }
}
