# Vite Configuration
# For overriding the dev server host
VITE_HOST=

# Database (server)
MYSQL_HOST=localhost
MYSQL_DATABASE=tamil-baby-names_db
MYSQL_USER=root
MYSQL_PASSWORD=devpass

# Signing key for the filter access token (server)
JWT_SECRET=change-me

# Google reCAPTCHA
# The secret key is read by the server at runtime.
RECAPTCHA_SECRET_KEY=
# The site key is inlined into the client bundle at BUILD time by Vite,
# so it must be set for `yarn build:client` / `yarn dev:client`.
RECAPTCHA_SITE_KEY=

# Server port (default 3000)
PORT=3000
