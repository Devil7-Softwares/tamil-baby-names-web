{
  "name": "@tbn/web",
  "version": "1.0.0",
  "description": "Web version of https://github.com/Devil7-Softwares/Tamil_Baby_Names",
  "repository": "https://github.com/Devil7-Softwares/tamil-baby-names-web",
  "author": "Dineshkumar T (Devil7DK)",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "dev": "concurrently --kill-others \"npm:dev:*\"",
    "dev:server": "tsx watch src/Server.ts",
    "dev:client": "vite",
    "build": "yarn build:client && yarn build:server",
    "build:client": "vite build",
    "build:server": "tsup",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@tbn/shared": "workspace:*",
    "axios": "^1.19.0",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-static-gzip": "^3.0.1",
    "file-saver": "^2.0.5",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.2",
    "pdfmake": "^0.3.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-drifter-stars": "^2.0.2",
    "react-google-recaptcha": "^3.1.0",
    "react-router-dom": "^7.18.2",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/file-saver": "^2.0.7",
    "@types/gtag.js": "^0.0.20",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/react-google-recaptcha": "^2.1.9",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-compression2": "^2.5.3"
  }
}
