# Port for the API server
PORT=3001

# Database
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DATABASE=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Signing key for the filter access token
JWT_SECRET=change-me

# Google reCAPTCHA secret, verified when an access token is requested
RECAPTCHA_SECRET_KEY=

# Admin dashboard
# Signs admin session cookies. The admin area is offline while this is unset.
ADMIN_JWT_SECRET=

# Seals the API keys stored on the agents table. 32 bytes, base64 or hex:
#   openssl rand -base64 32
# Agents that need an API key cannot be used while this is unset; a local
# Ollama agent still can. Changing it makes every key already saved unreadable.
AGENT_KEY_SECRET=

# Creates the first admin on startup while the admin_users table is empty
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# Overrides where the built clients are read from (default: ../public and
# ../public-admin beside dist, then ./public and ./public-admin under the cwd)
PUBLIC_DIR=
ADMIN_PUBLIC_DIR=
